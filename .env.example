# =============================================================================
# BSB FitForge - Environment Configuration
#
# Phase 0 (Foundation) does not require any of these values.
# The application runs fully on mock data until Phase 1 connects Supabase.
#
# Copy this file to `.env.local` and fill in your real Supabase project values
# when you are ready to enable authentication and data.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Phase 1+)
# Find these in your Supabase project: Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: service-role key (server-side only, NEVER exposed to the client)
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=BSB FitForge
