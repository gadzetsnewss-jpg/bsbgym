# =============================================================================
# BSB FitForge - Environment Configuration
#
# Phase 3 (Authentication & Organization Foundation) is enabled by configuring
# a Supabase project below. Without credentials the app runs in preview mode
# (no auth, mock data) so the foundation still builds and runs.
#
# Copy this file to `.env.local` and fill in your real Supabase project values.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required for Phase 3)
# Find these in your Supabase project: Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: service-role key (server-side only, NEVER exposed to the client).
# Only used by privileged server-side flows (e.g. future admin utilities).
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=BSB FitForge
